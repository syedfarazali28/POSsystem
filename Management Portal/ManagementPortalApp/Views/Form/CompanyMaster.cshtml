@inject ManagementPortalApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "Company";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section TopCss {
    <link href="~/Public/css/custom-css/Settings/UserMaster.css" rel="stylesheet" />
}

@{

    System.Security.Claims.ClaimsPrincipal claimsPrincipal = Context.User;
    var UniqueKey = (from c in claimsPrincipal.Claims where c.Type == "Guid" select c.Value).FirstOrDefault();
    var UserID = (from c in claimsPrincipal.Claims where c.Type == "UserID" select c.Value).FirstOrDefault();

    ManagementPortalApp.Models.Session.SessionItems sessionItems = Sessions_.GetSession(UniqueKey, UserID);

    List<ManagementPortalApp.Models.Authentication.RolesMapping> rolesMapping = sessionItems.rolesMapping;

    var FilterForm = rolesMapping.FirstOrDefault(x => x.FormName == Context.Request.RouteValues["controller"] + "/" + Context.Request.RouteValues["action"]);
    bool _allowinsert = FilterForm.AllowInsert;
    bool _allowupdate = FilterForm.AllowUpdate;
    bool _allowdelete = FilterForm.AllowDelete;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex">
                <h4 class="mb-0">Company</h4>
                <button class="btn btn-primary btn-block btn-orange d-block d-block ms-auto d-none" id="SuppliersUploadBtn" type="button"><i class='bx bxs-user'></i>Bulk Insert</button>
            </div>
            <div class="card-body">
                <form id="" name="" method="post" action="" autocomplete="off">
                    <div class="row">
                        <div class="col-12" id="Form1">
                            <table class="table datatable" id="inputtable">
                                <tbody>
                          
                                </tbody>
                            </table>
                        </div>

                    </div>


                    <div class="row mt-3">

                        <div class="col-12 d-flex justify-content-end">
                            @if (_allowinsert)
                            {
                                <button class="btn btn-primary btn-block btn-orange d-block savebutton" id="SaveBtn" type="button"><i class='bx bxs-save pe-2'></i>Save</button>

                            }
                            @if (_allowupdate)
                            {
                                <button class="btn btn-primary btn-block btn-orange d-none updatebutton" type="button" id="UpdateBtn"><i class='bx bxs-save pe-2'></i>Update</button>
                            }

                            <button class="btn btn-primary btn-block btn-orange d-block d-block ms-2 clearbutton" id="ClearBtn" type="button"><i class='bx bxs-save pe-2'></i>Clear</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div id="CompanymasterDiv">
                    <div class="div-loader">
                        <div class="loader-wrapper d-none">
                            <span class="loader"></span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered" id="Company-master">
                                <thead>
                                    <tr>
                                        <th>Company Name</th>
                                        <th>Contact Person</th>
                                        <th>Phone Number</th>
                                        <th>Email</th>                                    
                                        <th>Is Active</th>
                                        <th>ViewProfile</th>
                                        @if (_allowupdate)
                                        {
                                            <th>Edit</th>
                                        }
                                        @if (_allowdelete)
                                        {
                                            <th>Delete</th>
                                        }

                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="ModalCompanyProfile" tabindex="-1" aria-labelledby="CompanyProfileTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg border-0 rounded-3 overflow-hidden">

            <!-- Header -->
            <div class="modal-header bg-gradient text-white p-3 bg-dark">
                <h5 class="modal-title fw-bold" id="CompanyProfileTitle">
                    <i class="bx bxs-business me-2"></i> Company Profile
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body p-4">
                <div class="row g-4 align-items-center">

                    <!-- Logo -->
                    <div class="col-md-3 text-center align-self-start">
                        <img id="CompanyLogo" class="img-fluid border border-3 border-primary shadow-sm">
                    </div>

                    <!-- Details -->
                    <div class="col-md-12">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-body p-3">
                                <h4 class="fw-bold mb-1" id="ProfileCompanyName"></h4>
                                <p class="text-muted small mb-3" id="ProfileRegistrationNumber"></p>

                                <div class="row">
                                    <div class="col-6 mb-2">
                                        <strong>Contact Person:</strong><br>
                                        <span id="ProfileContactPerson"></span>
                                    </div>
                                    <div class="col-6 mb-2">
                                        <strong>Phone:</strong><br>
                                        <span id="ProfilePhoneNumber"></span>
                                    </div>
                                    <div class="col-6 mb-2">
                                        <strong>Email:</strong><br>
                                        <span id="ProfileEmail"></span>
                                    </div>
                                    <div class="col-6 mb-2">
                                        <strong>Website:</strong><br>
                                        <span id="ProfileWebsite"></span>
                                    </div>
                                    <div class="col-12 mb-2">
                                        <strong>Address:</strong><br>
                                        <span id="ProfileAddress"></span>
                                    </div>
                                    <div class="col-6 mb-2">
                                        <strong>City:</strong><br>
                                        <span id="ProfileCity"></span>
                                    </div>
                                    <div class="col-6 mb-2">
                                        <strong>Country:</strong><br>
                                        <span id="ProfileCountry"></span>
                                    </div>
                                    <div class="col-6 mb-2">
                                        <strong>GST Number:</strong><br>
                                        <span id="ProfileGSTNumber"></span>
                                    </div>
                                    <div class="col-6 mb-2">
                                        <strong>NTN Number:</strong><br>
                                        <span id="ProfileNTNNumber"></span>
                                    </div>
                                    <div class="col-6 mb-2">
                                        <strong>Status:</strong><br>
                                        <span id="ProfileStatus"></span>
                                    </div>
                                    <div class="col-6 mb-2">
                                        <strong>Created Date:</strong><br>
                                        <span id="ProfileCreatedDate"></span>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="bx bx-x-circle me-1"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>

@section BottomJS {
    <script src="~/public/js/custom-js/Form/Company.js"></script>
   
}

