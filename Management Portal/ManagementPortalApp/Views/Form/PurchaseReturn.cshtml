@inject ManagementPortalApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "Purchase Return";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section TopCss {
    <link href="~/public/css/custom-css/layout/purchase.css" rel="stylesheet" />
    <link href="~/Public/css/custom-css/Settings/UserMaster.css" rel="stylesheet" />
}

@{

    System.Security.Claims.ClaimsPrincipal claimsPrincipal = Context.User;
    var UniqueKey = (from c in claimsPrincipal.Claims where c.Type == "Guid" select c.Value).FirstOrDefault();
    var UserID = (from c in claimsPrincipal.Claims where c.Type == "UserID" select c.Value).FirstOrDefault();

    ManagementPortalApp.Models.Session.SessionItems sessionItems = Sessions_.GetSession(UniqueKey, UserID);

    List<ManagementPortalApp.Models.Authentication.RolesMapping> rolesMapping = sessionItems.rolesMapping;

    var FilterForm = rolesMapping.FirstOrDefault(x => x.FormName == Context.Request.RouteValues["controller"] + "/" + Context.Request.RouteValues["action"]);
    bool _allowinsert = FilterForm.AllowInsert;
    bool _allowupdate = FilterForm.AllowUpdate;
    bool _allowdelete = FilterForm.AllowDelete;
}
<div id="tabs">
    <ul>
        <li><a href="#FormScreen">New Purchase Entry</a></li>
        <li><a href="#DataScreen">Purchase Data</a></li>
    </ul>
    <div id="FormScreen">

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex">
                        <h4 class="mb-0">Purchase Entry</h4>
                        <span class="ms-auto" id="currentDateTime"></span>
                    </div>
                    <div id="Purchaseform" class="card-body">
                        <form id="purchaseForm" method="post" autocomplete="off" enctype="multipart/form-data">
                            <div class="row mb-3">
                                <input type="text" value="" id="PurchaseId" class="form-control d-none">
                                <div class="col-md-3">
                                    <label>Purchase Date</label>
                                    <small class="text-muted">*</small>
                                    <input type="date" id="PurchaseDate" validate-required class="form-control" required>
                                </div>
                                <div class="col-md-3">
                                    <label>Invoice Number <small class="text-muted">(Auto-generated)</small></label>
                                    <input type="text" readonly validate-required id="InvoiceNumber" class="form-control" placeholder="" required>
                                </div>
                                <div class="col-md-3">
                                    <label>Company</label>
                                    <small class="text-muted">*</small>
                                    <select id="CompanyID" validate-required class="form-control searchingenable" required>
                                        <option value="">-- Select Company --</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label>Payment Mode</label>
                                    <small class="text-muted">*</small>
                                    <select id="PaymentModeID" validate-required class="form-control searchingenable">
                                        <option value="">-- Select Payment Mode --</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label>Stock Location</label>
                                    <small class="text-muted">*</small>
                                    <select id="stocklocID" validate-required class="form-control searchingenable">
                                        <option value="">-- Select Stock Location --</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <label>Upload Physical Bill Image</label>
                                    <input type="file" id="BillImage" class="form-control" accept="image/*">
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <img id="BillImagesrc">
                                </div>
                            </div>
                            <div class="row">
                                <!-- Type -->
                                <div class="col-md-6">
                                    <span class="highlighted">


                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input transaction-type" type="radio" name="type" value="Purchase" checked>
                                            <label class="form-check-label">Purchase</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input transaction-type" type="radio" name="type" value="Return">
                                            <label class="form-check-label">Return</label>
                                        </div>
                                    </span>
                                </div>

                                <!-- Bonus -->
                                <div class="col-md-6 text-end float-end">
                                    <span class="highlighted2">
                                        <input type="checkbox" class="form-check-input isBonus" id="bonusCheckbox" title="Bonus Product">
                                        <label class="form-label">Bonus</label>
                                    </span>
                                </div>
                            </div>
                            <div class="container position-relative">
                                <!-- Loader -->
                                <div class="div-loader position-absolute w-100 text-center" style="top: 0; z-index: 999;">
                                    <div class="loader-wrapper d-none">
                                        <span class="loader spinner-border text-primary" role="status"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 p-2 border rounded text-center purchase-row">
                                    <div class="row">
                                        <!-- Category -->
                                        <div class="col-md-3 box">
                                            <label class="d-block mt-1">Category</label>
                                            <select id="category" class="form-control category" title="Select Category"></select>
                                        </div>

                                        <!-- Product -->
                                        <div class="col-md-3 box">
                                            <label class="d-block mt-1">Product</label>
                                            <select id="product" class="form-control product" title="Select Product"></select>
                                        </div>

                                        <!-- SKU -->
                                        <div class="col-md-3 box">
                                            <label class="d-block mt-1">SKU</label>
                                            <select id="productsku" class="form-control sku" title="Select SKU"></select>
                                        </div>

                                        <!-- Barcode -->
                                        <div class="col-md-3">
                                            <label class="d-block mt-1">
                                                Barcode
                                                <small class="text-muted"> (Auto-generated =>)</small>
                                                <button type="button" id="refresh" class="btn btn-sm btn-outline-secondary ms-1 p-1" title="Generate Barcode">
                                                    <i class='bx bx-refresh'></i>
                                                </button>
                                            </label>
                                            <input type="text" class="form-control barcode" placeholder="Scan or enter barcode" />
                                        </div>
                                    </div>

                                    <div class="row">
                                        <!-- Expiry Date -->
                                        <div class="col-md-3">
                                            <label class="d-block mt-1">Expiry Date</label>
                                            <input type="date" class="form-control expirydate" />
                                        </div>

                                        <!-- Quantity -->
                                        <div class="col-md-3">
                                            <label class="d-block mt-1">Qty</label>
                                            <input type="number" class="form-control qty" min="1" value="1" title="Quantity" />
                                        </div>

                                        <!-- Unit Price -->
                                        <div class="col-md-3">
                                            <label class="d-block mt-1">Unit Price</label>
                                            <input type="number" id="price" class="form-control price" min="0" value="0" title="Unit Price" />
                                        </div>

                                        <!-- Total -->
                                        <div class="col-md-3">
                                            <label class="d-block mt-1">Total</label>
                                            <input id="total" class="form-control  bg-light text-end total" type="text" readonly name="name" value="0.00" />
                                        </div>

                                        <!-- Bonus -->

                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <button type="button" id="AddEntry" class="btn btn-sm btn-success  float-end">Add Entry</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>



                            <div class="row">
                                <div class="table-responsive">
                                    <table class="table table-bordered" id="purchaseTable">
                                        <thead>
                                            <tr>
                                                <th>Type</th>
                                                <th>Category</th>
                                                <th>Product</th>
                                                <th>SKU</th>
                                                <th>Barcode</th>
                                                <th>Expiry Date</th>
                                                <th>Qty</th>
                                                <th>Unit Price</th>
                                                <th>Total</th>
                                                <th>Bonus</th>
                                                <th>Edit</th>
                                                <th>Delete</th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-12 text-end">
                                    <h5>Total Amount: <span id="totalAmount">0</span></h5>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-12 text-end">
                                    <h5 disable>Company Balance: <span id="Balance">0</span></h5>
                                </div>
                            </div>




                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <label>Remarks</label>
                                    <textarea id="Remarks" class="form-control" rows="2" placeholder="Optional remarks"></textarea>
                                </div>
                            </div>
                        </form>
                        <div class="row mt-3">

                            <div class="col-12 d-flex justify-content-end">
                                @if (_allowinsert)
                                {
                                    <button type="button" class="btn btn-primary btn-orange me-2" id="SaveBtn"><i class="bx bxs-save pe-2"></i>Save</button>

                                }
                                @if (_allowupdate)
                                {
                                    <button class="btn btn-primary btn-block btn-orange d-none updatebutton" type="button" id="UpdateBtn"><i class='bx bxs-save pe-2'></i>Update</button>
                                }

                                <button type="reset" class="btn btn-secondary" id="ClearForm"><i class="bx bx-refresh pe-2"></i>Clear</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="DataScreen">


        <div class="row mt-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div id="CategoryMasterDiv">
                            <div class="div-loader">
                                <div class="loader-wrapper d-none">
                                    <span class="loader"></span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-striped table-bordered" id="purchase-master">
                                        <thead>
                                            <tr>
                                                <th>InvoiceNumber</th>
                                                <th>PurchaseDate</th>
                                                <th>CompanyName</th>
                                                <th>TotalAmount</th>
                                                <th>PaymentModeName</th>
                                                <th>Remarks</th>
                                                <th>Physical Image</th>
                                                <th>CreatedDate</th>
                                                <th>Details</th>
                                                @if (_allowupdate)
                                                {
                                                    <th>Edit</th>
                                                }
                                                @if (_allowdelete)
                                                {
                                                    <th>Delete</th>
                                                }

                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade  bd-example-modal-lg" id="ModalActivepurchasedetails" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLongTitle">Purchase Details</h5>
                        <button type="button" class="btn-gray close closebtn" data-dismiss="modal" aria-label="Close" id="CloseModalBtn">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body table-responsive">
                                        <div id="ADUserMasterDiv">
                                            <div class="div-loader">
                                                <div class="loader-wrapper d-none">
                                                    <span class="loader"></span>
                                                </div>
                                                <div class="table-responsive">
                                                    <table class="table table-striped table-bordered" id="purchasedatails-master">
                                                        <thead>
                                                            <tr>
                                                                <th>SKU</th>
                                                                <th>Barcode</th>
                                                                <th>ExpiryDate</th>
                                                                <th>IsBonus</th>
                                                                <th>Quantity</th>
                                                                <th>UnitPrice</th>
                                                                <th>Total</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>


    </div>
</div>



@section BottomJS {
    <script src="~/public/js/custom-js/Form/purchasereturn.js"></script>

}

