@inject ManagementPortalApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "Sales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section TopCss {
    <link href="~/public/css/custom-css/layout/Sales.css" rel="stylesheet" />
    <link href="~/Public/css/custom-css/Settings/UserMaster.css" rel="stylesheet" />
}

@{
    System.Security.Claims.ClaimsPrincipal claimsPrincipal = Context.User;
    var UniqueKey = (from c in claimsPrincipal.Claims where c.Type == "Guid" select c.Value).FirstOrDefault();
    var UserID = (from c in claimsPrincipal.Claims where c.Type == "UserID" select c.Value).FirstOrDefault();

    ManagementPortalApp.Models.Session.SessionItems sessionItems = Sessions_.GetSession(UniqueKey, UserID);

    List<ManagementPortalApp.Models.Authentication.RolesMapping> rolesMapping = sessionItems.rolesMapping;

    var FilterForm = rolesMapping.FirstOrDefault(x => x.FormName == Context.Request.RouteValues["controller"] + "/" + Context.Request.RouteValues["action"]);
    bool _allowinsert = FilterForm.AllowInsert;
    bool _allowupdate = FilterForm.AllowUpdate;
    bool _allowdelete = FilterForm.AllowDelete;
}

<form id="SaleForm" method="post" autocomplete="off">
    <div id="tabs">
        <ul>
            <li><a href="#FormScreen">New Sale Entry</a></li>
            <li><a href="#DataScreen">Sale Data</a></li>
        </ul>

        <!-- ========================= FORM SCREEN ========================= -->
        <div id="FormScreen">
            <div class="row">
                <div class="col-12">
                   <div class="card">
                        <div class="card-header d-flex">
                            <h4 class="mb-0">Sale Entry</h4>
                            <span class="ms-auto" id="currentDateTime"></span>
                        </div>

                        <div class="card-body">
                            <input type="text" value="" id="SaleId" class="form-control d-none">

                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <label>Invoice Number</label>
                                    <input type="text" id="InvoiceNumber" class="form-control" readonly>
                                </div>
                                <div class="col-md-3">
                                    <label>Sale Date</label><small class="text-muted">*</small>
                                    <input type="date" id="SaleDate" class="form-control" required>
                                </div>

                                <div class="col-md-3">
                                    <label>Customer Name</label><small class="text-muted">*</small>
                                    <select id="CustomerID" class="form-control searchingenable" required>
                                        <option value="">-- Select Customer --</option>
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label>Stock Location</label><small class="text-muted">*</small>
                                    <select id="stocklocID" class="form-control searchingenable">
                                        <option value="">-- Select Stock Location --</option>
                                    </select>
                                </div>
                               

                            </div>
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <label>Upload Physical Bill Image</label>
                                    <input type="file" id="BillImage" class="form-control" accept="image/*">
                                </div>
                                <div class="col-md-3">
                                    <label>Payment Mode</label>
                                    <select id="PaymentModeID" class="form-control searchingenable">
                                        <option value="">-- Select Payment Mode --</option>
                                    </select>

                                </div>
                            </div>
                            <!-- Bonus -->
                            <div class="row">

                                <div class="col-4 d-flex align-items-center justify-content-start gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="SaleReturn">
                                        <label class="form-check-label" for="SaleReturn">
                                          Sale Return
                                        </label>
                                    </div>
                                  
                                </div>
                                <div class="col-4 d-flex align-items-center justify-content-end gap-3">
                                
                                </div>
                                <div class="col-4 d-flex align-items-center justify-content-end gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="fullDelivered">
                                        <label class="form-check-label" for="fullDelivered">
                                            Fully Delivered
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input isBonus" type="checkbox" id="bonusCheckbox">
                                        <label class="form-check-label" for="bonusCheckbox">
                                            Bonus
                                        </label>
                                    </div>
                                </div>
                            </div>


                            <!-- Product Entry Row -->
                            <div class="row mb-2 p-2 border rounded text-center Sale-row">
                                <div class="col-md-3">
                                    <label>SKU</label>
                                    <select id="productsku" class="form-control sku"></select>
                                </div>

                                <div class="col-md-3">
                                    <label>Barcode</label>
                                    <input type="text" class="form-control barcode" id="barcode" />
                                </div>

                                <div class="col-md-3">
                                    <label>Expiry Date</label>
                                    <input type="date" class="form-control expirydate" />
                                </div>

                                <div class="col-md-3">
                                    <label>Qty</label>
                                    <input type="number" class="form-control qty" min="1" value="1" />
                                </div>
                                <div class="col-md-3" id="Delivered">
                                    <label>Delivered Qty</label>
                                    <input type="number" class="form-control dqty" min="1" value="1" />
                                </div>

                                <div class="col-md-3 mt-2">
                                    <label>Unit Price</label>
                                    <input type="number" id="price" class="form-control price" min="0" value="0" />
                                </div>

                                <div class="col-md-3 mt-2">
                                    <label>Total</label>
                                    <input id="total" class="form-control bg-light text-end total" type="text" readonly value="0.00" />
                                </div>

                                <div class="col-md-3 mt-4">
                                    <button type="button" id="AddEntry" class="btn btn-sm btn-success float-end">Add Entry</button>
                                </div>
                            </div>

                            <!-- Details Table -->
                            <div class="row mt-3">
                                <div class="table-responsive">
                                    <table class="table table-bordered" id="SaleTable">
                                        <thead>
                                            <tr>
                                                <th>Product SKU</th>
                                                <th>Barcode</th>
                                                <th>Expiry Date</th>
                                                <th>Total Qty</th>
                                                <th>Delivered Qty</th>
                                                <th>Remaining Qty</th>
                                                <th>Unit Price</th>
                                                <th>Total</th>
                                                <th>Bonus</th>
                                                <th>Edit</th>
                                                <th>Delete</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Total & Balance -->

                            <div class="row mt-3">
                                <!-- Remarks Section -->
                                <div class="col-md-6 text-end">
                                </div>

                                <!-- Amount Section -->
                                <div class="col-md-6 text-end">
                                    <div class="mb-2 d-flex align-items-center">
                                        <label for="totalAmount" class="form-label h5 me-2 mb-0">Total Amount:</label>
                                        <input type="number" id="totalAmount" class="form-control w-25" readonly min="0" value="0.00">
                                    </div>
                                    <div class="mb-2 d-flex align-items-center">
                                        <label for="DiscountAmount" class="form-label h5 me-2 mb-0">Discount Amount:</label>
                                        <input type="number" id="DiscountAmount" class="form-control w-25" min="0" value="0.00">
                                    </div>
                                    <div class="mb-2 d-flex align-items-center">
                                        <label for="PaymentAmount" class="form-label h5 me-2 mb-0">Payment Amount:</label>
                                        <input type="number" id="PaymentAmount" class="form-control w-25" min="0" value="0.00">
                                    </div>
                               
                                    <div class="mb-2 d-flex align-items-center">
                                        <label for="remainingAmount" class="form-label h5 me-2 mb-0">Remaining Amount:</label>
                                        <input type="number" id="remainingAmount" class="form-control w-25" readonly min="0" value="0.00">
                                    </div>
                                    <div class="mb-2 d-flex align-items-center">
                                        <label for="companyBalance" class="form-label h5 me-2 mb-0">Company Balance:</label>
                                        <input type="number" id="companyBalance" class="form-control w-25" readonly min="0" value="0.00">
                                    </div>
                                </div>

                            </div>

                            <div class="col-md-12 mb-3">
                                <label for="Remarks" class="form-label">Remarks</label>
                                <textarea id="Remarks" class="form-control" rows="2" placeholder="Optional remarks"></textarea>

                            </div>
                            <!-- Buttons -->
                            <div class="row mt-3">
                                <div class="col-12 text-end">
                                    <button type="button" class="btn btn-primary me-2" id="SaveBtn">Save</button>
                                    <button type="reset" class="btn btn-secondary" id="ClearForm">Clear</button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================= DATA SCREEN ========================= -->
        <div id="DataScreen">
            <div class="row mt-3">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered" id="Sale-master">
                                    <thead>
                                        <tr>
                                            <th>SaleDate</th>
                                            <th>CustomerName</th>
                                            <th>TotalAmount</th>
                                            <th>Status</th>
                                            <th>Remarks</th>
                                            <th>CreatedDate</th>
                                            <th>Details</th>
                                            <th>Edit</th>
                                            <th>Delete</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</form>


@section BottomJS {
    <script src="~/public/js/custom-js/Form/Sales.js"></script>
}
