@inject ManagementPortalApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "Opening Stock";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section TopCss {
    <link href="~/public/css/custom-css/layout/purchase.css" rel="stylesheet" />
    <link href="~/Public/css/custom-css/Settings/UserMaster.css" rel="stylesheet" />
}

@{

    System.Security.Claims.ClaimsPrincipal claimsPrincipal = Context.User;
    var UniqueKey = (from c in claimsPrincipal.Claims where c.Type == "Guid" select c.Value).FirstOrDefault();
    var UserID = (from c in claimsPrincipal.Claims where c.Type == "UserID" select c.Value).FirstOrDefault();

    ManagementPortalApp.Models.Session.SessionItems sessionItems = Sessions_.GetSession(UniqueKey, UserID);

    List<ManagementPortalApp.Models.Authentication.RolesMapping> rolesMapping = sessionItems.rolesMapping;

    var FilterForm = rolesMapping.FirstOrDefault(x => x.FormName == Context.Request.RouteValues["controller"] + "/" + Context.Request.RouteValues["action"]);
    bool _allowinsert = FilterForm.AllowInsert;
    bool _allowupdate = FilterForm.AllowUpdate;
    bool _allowdelete = FilterForm.AllowDelete;
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex">
                <h4 class="mb-0">Opening Stock</h4>
                <span class="ms-auto" id="currentDateTime"></span>
            </div>
            <div id="Purchaseform" class="card-body">
                <form autocomplete="off" enctype="multipart/form-data">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label>Date</label>
                            <small class="text-muted">*</small>
                            <input type="date" id="Date" validate-required class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label>Category</label>
                            <small class="text-muted">*</small>
                            <select id="Categorydata" validate-required class="form-control searchingenable" required>
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Products</label>
                            <small class="text-muted">*</small>
                            <select id="ProductID" validate-required class="form-control searchingenable" required>
                                <option value="">-- Select Products --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Product Sku</label>
                            <small class="text-muted">*</small>
                            <select id="productsku" validate-required class="form-control searchingenable" required>
                                <option value="">-- Select Sku --</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label>Quantity</label>
                            <small class="text-muted">*</small>
                            <input type="number" class="form-control qty" min="1" value="1" title="Quantity" />
                        </div>
                        <div class="col-md-4">
                            <label>Unit Price</label>
                            <small class="text-muted">*</small>
                            <input type="number" class="form-control price" min="1" value="1" title="price" />
                        </div>
                        <div class="col-md-4">
                            <label>Total Price</label>
                            <small class="text-muted">*</small>
                            <input type="number" class="form-control Total" readonly min="1" value="1" title="price" />
                        </div>
                        @if (_allowinsert && _allowupdate)
                        {
                            <div class="col-md-3 mt-3">
                                <button type="button" class="btn btn-primary btn-orange me-2" id="SaveBtn"><i class="bx bxs-save pe-2"></i>Add Opening Balance</button>
                            </div>
                        }
                      

                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-bordered" id="stockTable">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Product Name</th>
                                    <th class="text-end">Opening Qty</th>
                                    <th>Date</th>
                                    <th class="text-end">Debit Amount</th>
                                    <th class="text-end">Credit Amount</th>
                                    <th>Narration</th>
                                    <th>Voucher Type</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="4" class="text-dark">Total:</th>
                                    <th id="totalDebit" class="text-dark"></th>
                                    <th id="totalCredit" class="text-dark"></th>
                                    <th colspan="2"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section BottomJS {
    <script src="~/public/js/custom-js/Form/OpeningStock.js"></script>

}

